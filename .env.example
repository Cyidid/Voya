# ================================
# 环境变量配置文件模板
# ================================
#
# 使用方法：
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 填写你的 API keys
#
# 3. 确保 .env 文件不会被提交到 Git（.gitignore 已配置）
#
# ================================

# ----------------
# 本地运行配置
# ----------------

# 是否使用本地版本的 Agent（使用 OpenAI SDK）
USE_LOCAL_AGENT=true

# ----------------
# 大模型 API 配置（必需）
# ----------------

# OpenAI 兼容 API（推荐使用豆包）
# 获取方式：https://console.volcengine.com/ark
OPENAI_API_KEY=你的豆包API密钥
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 或使用通义千问
# OPENAI_API_KEY=你的通义千问API密钥
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 或使用 DeepSeek
# OPENAI_API_KEY=你的DeepSeek API密钥
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名称（可选，默认使用配置文件中的值）
# MODEL_NAME=doubao-seed-1-8-251228

# ----------------
# Web Search API 配置（推荐）
# ----------------

# Tavily Search API（推荐，每月 1000 次免费）
# 获取方式：https://tavily.com/
TAVILY_API_KEY=你的Tavily API密钥

# 或使用 Bing Search API
# BING_SEARCH_API_KEY=你的Bing Search API密钥
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# ----------------
# 知识库配置（自动）
# ----------------

# 本地知识库使用 ChromaDB，数据存储在 assets/knowledge_db
# 无需额外配置，系统会自动管理

# ----------------
# 系统配置（可选）
# ----------------

# 日志级别
LOG_LEVEL=INFO

# API 服务端口
API_PORT=8000

# API 服务主机
API_HOST=0.0.0.0

# 是否启用知识库
ENABLE_KNOWLEDGE=true

# 是否启用 Web Search
ENABLE_WEB_SEARCH=true

# ================================
# 快速开始
# ================================
#
# 1. 复制配置文件
#    cp .env.example .env
#
# 2. 编辑 .env 文件，至少配置一个大模型 API
#
# 3. 安装依赖
#    pip install -r requirements_local.txt
#
# 4. 导入知识库
#    python scripts/import_local_knowledge.py
#
# 5. 启动服务
#    python scripts/start_and_preview.py
#
# 6. 访问系统
#    http://localhost:8000/preview
#
# ================================
# API Keys 获取指南
# ================================
#
# 豆包 Doubao（推荐，新用户免费）
# 1. 访问 https://console.volcengine.com/ark
# 2. 注册/登录
# 3. 创建 API Key
# 4. 复制 Key 到 OPENAI_API_KEY
#
# 通义千问（新用户免费）
# 1. 访问 https://bailian.console.aliyun.com/
# 2. 注册/登录
# 3. 开通服务
# 4. 创建 API Key
# 5. 复制 Key 到 OPENAI_API_KEY
#
# DeepSeek（价格较低）
# 1. 访问 https://platform.deepseek.com/
# 2. 注册/登录
# 3. 创建 API Key
# 4. 复制 Key 到 OPENAI_API_KEY
#
# Tavily Search（每月 1000 次免费）
# 1. 访问 https://tavily.com/
# 2. 注册/登录
# 3. 创建 API Key
# 4. 复制 Key 到 TAVILY_API_KEY
#
# ================================
