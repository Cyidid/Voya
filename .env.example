# =============================================================
# Voya · Environment Variables Template
# =============================================================
# Usage:
#   cp .env.example .env
# Then fill in your API keys. The .env file is git-ignored.
# =============================================================

# -------------------------------------------------------------
# LLM API  (required — pick one)
# -------------------------------------------------------------

# 推荐：通义千问（当前使用的模型）
# Get your key → https://bailian.console.aliyun.com/
OPENAI_API_KEY=your_qwen_api_key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.6-plus

# Alternative: DeepSeek
# Get your key → https://platform.deepseek.com/
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

# -------------------------------------------------------------
# Web Search API  (optional — enables real-time info)
# -------------------------------------------------------------

# Tavily — 1,000 free searches/month
# Get your key → https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key

# -------------------------------------------------------------
# System settings  (optional — defaults shown)
# -------------------------------------------------------------

LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0
ENABLE_KNOWLEDGE=true
ENABLE_WEB_SEARCH=true
